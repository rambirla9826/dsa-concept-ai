# Environment Configuration
PORT=8000
HOST=0.0.0.0
ENV=development

# Security
JWT_SECRET=super_secret_jwt_key_change_in_production_32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / Gemini API Configuration
# Get your free key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Firebase Admin / Firestore Configuration
# If left empty, backend will automatically operate in local persistent JSON/Memory DB mode for instant testing!
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Rate Limits
DAILY_FREE_EVAL_LIMIT=50
